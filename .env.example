# Port the MCP server listens on.
PORT=8931

# Bind address. Loopback by default. Set to 0.0.0.0 only if the harness runs in
# a container and must reach this server via host.docker.internal -- that also
# exposes the port to your local network, where the bearer token below is the
# only thing standing in front of container control.
SENTINEL_HOST=127.0.0.1

# Shared secret the harness must send as `Authorization: Bearer <token>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The server refuses to start without it.
SENTINEL_AUTH_TOKEN=

# Only containers carrying this label are visible to the agent. This is the
# blast-radius boundary: anything unlabelled is invisible and untouchable.
SENTINEL_LABEL=sentinel.managed=true

# Extra Host header values to accept, comma separated. localhost, 127.0.0.1 and
# host.docker.internal are always allowed. Requests carrying any other Host are
# rejected, which is what stops a browser on your network being tricked into
# driving this server.
# SENTINEL_ALLOWED_HOSTS=

# Docker daemon socket. Leave unset to use the platform default
# (/var/run/docker.sock on Linux/macOS, //./pipe/docker_engine on Windows).
# DOCKER_HOST=

# Model provider key, used by the TrueForge harness rather than this server.
# Groq is OpenAI-compatible; the harness points at
# https://api.groq.com/openai/v1 as a custom endpoint.
GROQ_API_KEY=

# Sandbox provider key, used by the harness. Optional: without it the agent can
# investigate and remediate but cannot write and run its own analysis code.
# Create one at https://app.daytona.io/dashboard/keys with these scopes:
#   write:sandboxes  delete:sandboxes  write:snapshots  delete:snapshots
DAYTONA_API_KEY=
