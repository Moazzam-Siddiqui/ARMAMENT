# Used by Docker Compose to bind ports. Keep access restricted by your host firewall.
ARMAMENT_BIND_ADDRESS=0.0.0.0

# Required bearer token for the MCP server. Setup generates this automatically.
SENTINEL_AUTH_TOKEN=

# Scope boundary: only containers with this exact label are manageable.
SENTINEL_LABEL=sentinel.managed=true
SENTINEL_ALLOWED_HOSTS=host.docker.internal

# Provider credentials are read by scripts/provision.py on the host, not passed
# into the ARMAMENT Docker containers.
GROQ_API_KEY=
DAYTONA_API_KEY=

# TrueForge harness configuration.
TRUEFORGE_URL=http://localhost:8791
SENTINEL_MCP_URL=http://host.docker.internal:8931/mcp
GROQ_BASE_URL=http://host.docker.internal:8932/v1
